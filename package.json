{
  "name": "wens-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-content.mjs && SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next build --webpack",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "lefthook install",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "convex": "^1.45.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "lefthook": "^2.1.12",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
